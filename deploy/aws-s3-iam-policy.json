{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RealEstateProS3MediaAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:PutObjectAcl"
      ],
      "Resource": "arn:aws:s3:::realestatepro-media/*"
    },
    {
      "Sid": "RealEstateProS3ListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::realestatepro-media"
    },
    {
      "Sid": "RealEstateProSESSendMail",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "*"
    }
  ]
}
